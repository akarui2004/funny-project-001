{
  "name": "backend-fund-project-001",
  "version": "1.0.0",
  "description": "This is just a project for fun",
  "main": "src/server.ts",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include \"config/*.toml\" -r dotenv/config src/server.ts",
    "start": "yarn clean && yarn build && node dist/server.js",
    "script": "tsx --tsconfig scripts/tsconfig.json -r dotenv/config",
    "console": "npx tsx ./scripts/console.ts",
    "build": "tsc --project ./tsconfig.json && tsc-alias",
    "db:migrate": "yarn script ./scripts/db/migrate-cli migrate up",
    "db:migrate:undo": "yarn script ./scripts/db/migrate-cli migrate down",
    "db:migrate:status": "yarn script ./scripts/db/migrate-cli migrate status",
    "db:migration:create": "yarn script ./scripts/db/migration-cli create",
    "config:validate": "yarn script ./scripts/config/config-cli validate",
    "clean": "rimraf ./dist",
    "test": "tsx --tsconfig tsconfig.test.json --test --test-reporter=./tests/reporters/pretty-reporter.mts \"tests/**/*.test.ts\"",
    "test:types": "tsc -p tsconfig.test.json",
    "test:watch": "tsx --tsconfig tsconfig.test.json --test --test-reporter=./tests/reporters/pretty-reporter.mts --watch \"tests/**/*.test.ts\"",
    "test:coverage": "tsx --tsconfig tsconfig.test.json --test --test-reporter=spec --experimental-test-coverage \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "ansis": "^4.3.1",
    "bignumber.js": "^11.1.5",
    "commander": "^15.0.0",
    "cors": "^2.8.6",
    "date-fns": "^4.2.1",
    "defu": "^6.1.7",
    "dotenv": "^18.0.9",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "kysely": "^0.29.8",
    "pg": "^8.20.0",
    "toml": "^5.0.0",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.23.1",
    "rimraf": "^6.1.4",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.0",
    "typescript": "7.0.2"
  },
  "resolutions": {
    "minimatch": "^11.0.1"
  }
}
