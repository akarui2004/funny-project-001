{
  "name": "backend-fund-project-001",
  "version": "1.0.0",
  "description": "This is just a project for fun",
  "main": "src/server.ts",
  "license": "MIT",
  "scripts": {
    "dev": "nodemon",
    "start": "yarn clean && yarn build && node dist/server.js",
    "script": "ts-node -r dotenv/config -r tsconfig-paths/register",
    "console": "npx tsx ./scripts/console.ts",
    "build": "tsc --project ./tsconfig.json && tsc-alias",
    "db:migrate": "yarn script ./scripts/db/migrate-cli migrate up",
    "db:migrate:undo": "yarn script ./scripts/db/migrate-cli migrate down",
    "db:migrate:status": "yarn script ./scripts/db/migrate-cli migrate status",
    "db:migration:create": "yarn script ./scripts/db/migration-cli create",
    "config:validate": "yarn script ./scripts/config/config-cli validate",
    "clean": "rimraf ./dist",
    "test": "tsx --test --test-reporter=./tests/reporters/pretty-reporter.mts \"tests/**/*.test.ts\"",
    "test:types": "tsc -p tsconfig.test.json",
    "test:watch": "tsx --test --test-reporter=./tests/reporters/pretty-reporter.mts --watch \"tests/**/*.test.ts\"",
    "test:coverage": "tsx --test --test-reporter=spec --experimental-test-coverage \"tests/**/*.test.ts\""
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts,toml",
    "ignore": [
      "dist/**",
      "logs/**",
      "scripts/**"
    ],
    "exec": "ts-node -r dotenv/config -r tsconfig-paths/register src/server.ts"
  },
  "dependencies": {
    "ansis": "^4.3.1",
    "bignumber.js": "^11.1.5",
    "commander": "^15.0.0",
    "cors": "^2.8.6",
    "date-fns": "^4.2.1",
    "defu": "^6.1.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jose": "^6.2.12",
    "kysely": "^0.29.8",
    "nodemon": "^3.1.14",
    "pg": "^8.20.0",
    "toml": "^5.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.0",
    "typescript": "5.9.3",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.23.1",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.1"
  },
  "resolutions": {
    "uuid": "^11.1.1"
  }
}
